# What T3 and each agent in a workbench with a 1Password service account get in their environment.
# Each line is a name and a 1Password reference. `op run` in workbench-start.sh reads each value at the start. No value is in a file.
GH_TOKEN=op://workbench/GH_TOKEN/credential
NODE_AUTH_TOKEN=op://workbench/DIGIO_PACKAGES_TOKEN/credential
VERCEL_TOKEN=op://workbench/VERCEL_TOKEN/credential
NEON_API_KEY=op://workbench/NEON_API_KEY/credential
CLAUDE_CODE_OAUTH_TOKEN=op://workbench/CLAUDE_CODE_OAUTH_TOKEN/credential
DIGIO_HISTORY_DATABASE_URL=op://workbench/DIGIO_HISTORY_DATABASE_URL/credential
