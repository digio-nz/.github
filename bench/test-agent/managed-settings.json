{
  "allowManagedPermissionRulesOnly": true,
  "allowManagedMcpServersOnly": true,
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "mcp__test-browser__*",
      "Read",
      "Glob",
      "Grep",
      "Skill",
      "Bash(bash /home/vscode/.claude/skills/*/scripts/*)"
    ],
    "deny": ["mcp__test-browser__browser_run_code_unsafe", "mcp__test-browser__browser_annotate", "mcp__test-browser__browser_resume", "Edit", "Write", "NotebookEdit", "WebFetch", "WebSearch", "Agent"]
  }
}
